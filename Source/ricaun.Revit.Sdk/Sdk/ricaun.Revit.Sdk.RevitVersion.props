<Project>

  <!-- RevitVersion.TargetFramework -->
  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <RevitVersion Condition="$(TargetFramework.StartsWith('net46'))">2017</RevitVersion>
    <RevitVersion Condition="$(TargetFramework.StartsWith('net47'))">2019</RevitVersion>
    <RevitVersion Condition="$(TargetFramework.StartsWith('net48'))">2021</RevitVersion>
    <RevitVersion Condition="$(TargetFramework.StartsWith('net8.0'))">2025</RevitVersion>
    <RevitVersion Condition="$(TargetFramework.StartsWith('net10.0'))">2027</RevitVersion>
    <RevitVersion Condition="$(TargetFramework.StartsWith('net12.0'))">2029</RevitVersion>
    <RevitVersion Condition="$(TargetFramework.StartsWith('net14.0'))">2031</RevitVersion>
  </PropertyGroup>

  <!-- TargetFrameworks -->
  <PropertyGroup>
    <IsTargetFrameworkNumeric>false</IsTargetFrameworkNumeric>
    <IsTargetFrameworkNumeric Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(TargetFramework)', '^[0-9]+$'))">true</IsTargetFrameworkNumeric>
  </PropertyGroup>
  <PropertyGroup Condition="$(IsTargetFrameworkNumeric)">
    <RevitVersion>$(TargetFramework)</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="!$(IsTargetFrameworkNumeric)">
    <RevitVersion Condition="$(RevitVersion) == ''">$([System.DateTime]::Now.Year)</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2017'))">2017</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2018'))">2018</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2019'))">2019</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2020'))">2020</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2021'))">2021</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2022'))">2022</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2023'))">2023</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2024'))">2024</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2025'))">2025</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2026'))">2026</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2027'))">2027</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2028'))">2028</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2029'))">2029</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2030'))">2030</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2031'))">2031</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2032'))">2032</RevitVersion>
  </PropertyGroup>
  <PropertyGroup>
    <IsRevitVersionNetCore>false</IsRevitVersionNetCore>
    <IsRevitVersionNetCore Condition="$(RevitVersion) &gt;= '2025'">true</IsRevitVersionNetCore>
    <IsRevitVersionNetFramework>false</IsRevitVersionNetFramework>
    <IsRevitVersionNetFramework Condition="!$(IsRevitVersionNetCore)">true</IsRevitVersionNetFramework>
  </PropertyGroup>
  
  <!-- BeforeTargetFrameworkInferenceTargets -->
  <PropertyGroup>
    <BeforeTargetFrameworkInferenceTargets>$(MSBuildThisFileDirectory)BeforeTargetFrameworkInferenceTargets.targets</BeforeTargetFrameworkInferenceTargets>
  </PropertyGroup>
  
</Project>