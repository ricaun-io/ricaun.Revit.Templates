<Project>

  <!-- AutoCADVersion.TargetFramework -->
  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <AutoCADVersion Condition="$(TargetFramework.StartsWith('net46'))">2017</AutoCADVersion>
    <AutoCADVersion Condition="$(TargetFramework.StartsWith('net47'))">2019</AutoCADVersion>
    <AutoCADVersion Condition="$(TargetFramework.StartsWith('net48'))">2021</AutoCADVersion>
    <AutoCADVersion Condition="$(TargetFramework.StartsWith('net8.0'))">2025</AutoCADVersion>
    <AutoCADVersion Condition="$(TargetFramework.StartsWith('net10.0'))">2027</AutoCADVersion>
    <AutoCADVersion Condition="$(TargetFramework.StartsWith('net12.0'))">2029</AutoCADVersion>
    <AutoCADVersion Condition="$(TargetFramework.StartsWith('net14.0'))">2031</AutoCADVersion>
  </PropertyGroup>

  <!-- TargetFrameworks -->
  <PropertyGroup>
    <IsTargetFrameworkNumeric>false</IsTargetFrameworkNumeric>
    <IsTargetFrameworkNumeric Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(TargetFramework)', '^[0-9]+$'))">true</IsTargetFrameworkNumeric>
  </PropertyGroup>
  <PropertyGroup Condition="$(IsTargetFrameworkNumeric)">
    <AutoCADVersion>$(TargetFramework)</AutoCADVersion>
  </PropertyGroup>
  <PropertyGroup Condition="!$(IsTargetFrameworkNumeric)">
    <AutoCADVersion Condition="$(AutoCADVersion) == ''">$([System.DateTime]::Now.Year)</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2017'))">2017</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2018'))">2018</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2019'))">2019</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2020'))">2020</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2021'))">2021</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2022'))">2022</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2023'))">2023</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2024'))">2024</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2025'))">2025</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2026'))">2026</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2027'))">2027</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2028'))">2028</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2029'))">2029</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2030'))">2030</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2031'))">2031</AutoCADVersion>
    <AutoCADVersion Condition="$(Configuration.Contains('2032'))">2032</AutoCADVersion>
  </PropertyGroup>
  <PropertyGroup>
    <IsAutoCADVersionNetCore>false</IsAutoCADVersionNetCore>
    <IsAutoCADVersionNetCore Condition="$(AutoCADVersion) &gt;= '2025'">true</IsAutoCADVersionNetCore>
    <IsAutoCADVersionNetFramework>false</IsAutoCADVersionNetFramework>
    <IsAutoCADVersionNetFramework Condition="!$(IsAutoCADVersionNetCore)">true</IsAutoCADVersionNetFramework>
  </PropertyGroup>
  
  <!-- BeforeTargetFrameworkInferenceTargets -->
  <PropertyGroup>
    <BeforeTargetFrameworkInferenceTargets>$(MSBuildThisFileDirectory)BeforeTargetFrameworkInferenceTargets.targets</BeforeTargetFrameworkInferenceTargets>
  </PropertyGroup>
  
</Project>
