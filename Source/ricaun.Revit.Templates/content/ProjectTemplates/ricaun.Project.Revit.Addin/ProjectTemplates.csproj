<Project Sdk="ricaun.Revit.Sdk/1.0.0">

  <PropertyGroup>
    <AppLoader>Debug</AppLoader>
    <UseWPF>true</UseWPF>
    <TargetFrameworks>TargetFrameworksReplace</TargetFrameworks>
  </PropertyGroup>
  
  <PropertyGroup>
    <PackageId>ProjectTemplates</PackageId>
    <Company>CompanyReplace</Company>
    <Authors>AuthorsReplace</Authors>
    <Description>DescriptionReplace</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ricaun.Revit.DB" Version="*"/>
    <PackageReference Include="ricaun.Revit.UI" Version="*"/>
    <PackageReference Include="ricaun.Revit.Mvvm" Version="*"/>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Revit.ico" />
  </ItemGroup>

  <!-- Fody -->
  <ItemGroup>
    <PackageReference Include="PropertyChanged.Fody" Version="3.*" IncludeAssets="build; compile" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <WeaverConfiguration>
      <Weavers>
        <PropertyChanged />
      </Weavers>
    </WeaverConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*-*" IncludeAssets="build; compile" PrivateAssets="All" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*-*" IncludeAssets="build; compile" PrivateAssets="All" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitVersion).*-*" IncludeAssets="build; compile" PrivateAssets="All" />
    <PackageReference Include="Nice3point.Revit.Api.UIFramework" Version="$(RevitVersion).*-*" IncludeAssets="build; compile" PrivateAssets="All" />
  </ItemGroup>

</Project>
