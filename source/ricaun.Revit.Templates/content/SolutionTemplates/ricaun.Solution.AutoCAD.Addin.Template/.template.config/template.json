{
  "$schema": "http://json.schemastore.org/template",
  "author": "ricaun",
  "name": "Solution Autodesk AutoCAD Addin Template",
  "shortName": "ricaun-autocad-addin-sln",
  "identity": "ricaun.Solution.AutoCAD.Addin.Template",
  "defaultName": "AutoCADAddin",
  "sourceName": "SolutionTemplates",
  "description": "Solution for AutoCAD C# .NET add-in project with Build",
  "classifications": [ "ricaun", "AutoCAD", "Solution" ],
  "tags": {
    "platform": ".NET",
    "language": "C#",
    "type": "solution",
    "editorTreatAs": "solution"
  },
  "guids": [
    "00000000-0000-0000-0000-000000000000",
    "11111111-1111-1111-1111-111111111111",
    "22222222-2222-2222-2222-222222222222",
    "33333333-3333-3333-3333-333333333333",
    "44444444-4444-4444-4444-444444444444",
    "99999999-9999-9999-9999-999999999999"
  ],
  "symbols": {
    "Authors": {
      "type": "parameter",
      "description": "Set Project Authors PropertyGroup",
      "replaces": "AuthorsReplace",
      "datatype": "string",
      "defaultValue": "Authors"
    },
    "Company": {
      "type": "parameter",
      "description": "Set Project Company PropertyGroup",
      "replaces": "CompanyReplace",
      "datatype": "string",
      "defaultValue": "Company"
    },
    "License": {
      "type": "parameter",
      "description": "Set Project License MIT",
      "dataType": "bool",
      "defaultValue": "true"
    },
    "Description": {
      "type": "parameter",
      "description": "Set Project Description PropertyGroup",
      "replaces": "DescriptionReplace",
      "datatype": "string",
      "defaultValue": "AutoCAD Plugin Description for $(PackageId)."
    },
    "TargetFrameworks": {
      "type": "parameter",
      "description": "Target Frameworks for AutoCAD versions",
      "datatype": "choice",
      "allowMultipleValues": true,
      "defaultValue": "2027|2026|2025|2024|2023|2022|2021",
      "choices": [
        {
          "choice": "2027",
          "description": "AutoCAD 2027 - Target .NET 10.0"
        },
        {
          "choice": "2026",
          "description": "AutoCAD 2026 - Target .NET 8.0"
        },
        {
          "choice": "2025",
          "description": "AutoCAD 2025 - Target .NET 8.0"
        },
        {
          "choice": "2024",
          "description": "AutoCAD 2024 - Target .NET Framework 4.8"
        },
        {
          "choice": "2023",
          "description": "AutoCAD 2023 - Target .NET Framework 4.8"
        },
        {
          "choice": "2022",
          "description": "AutoCAD 2022 - Target .NET Framework 4.8"
        },
        {
          "choice": "2021",
          "description": "AutoCAD 2021 - Target .NET Framework 4.8"
        },
        {
          "choice": "2020",
          "description": "AutoCAD 2020 - Target .NET Framework 4.7"
        },
        {
          "choice": "2019",
          "description": "AutoCAD 2019 - Target .NET Framework 4.7"
        }
      ]
    },
    "TargetFrameworksMsBuild": {
      "type": "derived",
      "valueSource": "TargetFrameworks",
      "valueTransform": "ReplaceWithSemicolon",
      "replaces": "TargetFrameworksReplace"
    },
    "LastTargetFramework": {
      "type": "derived",
      "valueSource": "TargetFrameworks",
      "valueTransform": "LastItem",
      "replaces": "LastTargetFrameworkReplace"
    }
  },
  "forms": {
    "ReplaceWithSemicolon": {
      "identifier": "replace",
      "pattern": "\\|",
      "replacement": ";"
    },
    "LastItem": {
      "identifier": "replace",
      "pattern": "^.*\\|([^|]+)$",
      "replacement": "$1"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!License)",
          "exclude": [
            "LICENSE"
          ]
        }
      ]
    }
  ]
}
