  <PropertyGroup>
    <!-- TargetFrameworksReplace -->
    <!-- LastTargetFrameworkReplace -->
    <AppLoader>Debug</AppLoader>
    <UseWPF>true</UseWPF>
    <!--#if (!NoRevitVersion)
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
#endif-->
    <!--#if (NoRevitVersion)
    <TargetFrameworks>2019;2020;2021;2022;2023;2024;2025;2026;2027</TargetFrameworks>
#endif-->
    <!--#if (!NoRevitVersion)
