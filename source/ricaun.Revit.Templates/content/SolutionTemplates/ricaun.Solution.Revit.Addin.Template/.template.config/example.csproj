  </ItemGroup>

  <ItemGroup>
    <None Include="Revit\App.cs" />
    <None Include="Revit\Commands\Command.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Revit.ico" />
  </ItemGroup>

  <!-- Fody -->
